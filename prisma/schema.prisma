datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  partner_user
  channel_admin
}

enum PartnerTier {
  Registered
  Silver
  Gold
  Platinum
}

enum OrgStatus {
  active
  suspended
}

enum MembershipRole {
  partner_owner
  partner_member
}

enum DealStatus {
  draft
  awaiting_approval
  approved
  declined
  closed_won
  closed_lost
  expired
}

enum LeadStatus {
  new
  assigned
  working
  qualified
  disqualified
  converted
}

enum LeadAcceptanceStatus {
  pending
  accepted
  declined
}

enum ResourceCategory {
  sales_playbook
  product_collateral
  technical_enablement
  certification
  marketing_asset
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  password_hash     String
  full_name         String
  job_title         String?
  phone             String?
  role              UserRole     @default(partner_user)
  email_verified_at DateTime?
  is_active         Boolean      @default(true)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  memberships       PartnerMembership[]
  deals_submitted   DealRegistration[]    @relation("DealsSubmitted")
  deals_reviewed    DealRegistration[]    @relation("DealsReviewed")
  status_changes    DealStatusHistory[]
  leads_assigned    LeadAssignment[]      @relation("LeadsAssignedBy")
  audit_events      AuditEvent[]
  notifications     Notification[]
  commercial_requests CommercialRequest[]  @relation("CommercialRequestsByUser")
  course_enrollments  CourseEnrollment[]
  certifications      PartnerCertification[]
  event_registrations EventRegistration[]
  terms_acceptances   TermsAcceptance[]
  support_tickets_created  SupportTicket[]  @relation("TicketsCreated")
  support_tickets_assigned SupportTicket[]  @relation("TicketsAssigned")
  ticket_messages          TicketMessage[]

  @@map("users")
}

model PartnerOrganization {
  id                      String      @id @default(cuid())
  legal_name              String
  display_name            String
  website                 String
  country                 String
  region                  String
  partner_type            String
  primary_focus           String?
  market_vertical         String?
  company_summary         String?
  tier                    PartnerTier @default(Registered)
  partner_manager_user_id String?
  partner_manager_name    String?     @default("Sarah Jenkins (Channel Director)")
  partner_manager_email   String?     @default("sarah.jenkins@omnipriv.internal")
  status                  OrgStatus   @default(active)
  created_at              DateTime    @default(now())
  updated_at              DateTime    @updatedAt

  memberships             PartnerMembership[]
  product_licenses        ProductLicense[]
  deals                   DealRegistration[]
  lead_assignments        LeadAssignment[]
  renewals                Renewal[]
  audit_events            AuditEvent[]
  notifications           Notification[]
  commercial_requests     CommercialRequest[]
  course_enrollments      CourseEnrollment[]
  partner_certifications  PartnerCertification[]
  event_registrations     EventRegistration[]
  joint_business_plans    JointBusinessPlan[]
  terms_acceptances       TermsAcceptance[]
  locator_profile         PartnerLocatorProfile?
  support_tickets         SupportTicket[]

  @@index([tier])
  @@index([status])
  @@index([country])
  @@map("partner_organizations")
}

model PartnerMembership {
  id                      String         @id @default(cuid())
  user_id                 String
  partner_organization_id String
  role                    MembershipRole @default(partner_member)
  invited_by_user_id      String?
  joined_at               DateTime       @default(now())
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt

  user                    User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization            PartnerOrganization @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)

  @@unique([user_id, partner_organization_id])
  @@index([partner_organization_id])
  @@index([user_id])
  @@map("partner_memberships")
}

model DealRegistration {
  id                            String      @id @default(cuid())
  public_reference              String      @unique
  partner_organization_id       String
  submitted_by_user_id          String
  customer_legal_name           String
  customer_domain               String
  customer_country              String
  customer_industry             String?
  customer_contact_name         String
  customer_contact_email        String
  customer_contact_phone        String?
  product_interest              String
  deployment_type               String
  estimated_arr                 Float?
  estimated_deal_value          Float?
  currency                      String      @default("USD")
  expected_seat_count           Int?
  expected_close_date           DateTime?
  deployment_timeline           String?
  opportunity_source            String?
  partner_notes                 String?
  status                        DealStatus  @default(draft)
  conflict_detected             Boolean     @default(false)
  conflict_reason               String?
  reviewed_by_user_id           String?
  reviewed_at                   DateTime?
  admin_decision_reason         String?
  protection_starts_at          DateTime?
  protection_expires_at         DateTime?
  closed_at                     DateTime?
  converted_from_lead_assignment_id String? @unique
  created_at                    DateTime    @default(now())
  updated_at                    DateTime    @updatedAt

  organization                  PartnerOrganization @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)
  submitted_by                  User                @relation("DealsSubmitted", fields: [submitted_by_user_id], references: [id])
  reviewed_by                   User?               @relation("DealsReviewed", fields: [reviewed_by_user_id], references: [id])
  status_history                DealStatusHistory[]
  converted_lead_assignment     LeadAssignment?     @relation("ConvertedDeal", fields: [converted_from_lead_assignment_id], references: [id])

  @@index([partner_organization_id])
  @@index([status])
  @@index([customer_domain])
  @@index([protection_expires_at])
  @@index([created_at])
  @@map("deal_registrations")
}

model DealStatusHistory {
  id                   String           @id @default(cuid())
  deal_registration_id String
  previous_status      DealStatus?
  new_status           DealStatus
  changed_by_user_id   String?
  note                 String?
  created_at           DateTime         @default(now())

  deal                 DealRegistration @relation(fields: [deal_registration_id], references: [id], onDelete: Cascade)
  changed_by           User?            @relation(fields: [changed_by_user_id], references: [id])

  @@index([deal_registration_id])
  @@index([created_at])
  @@map("deal_status_history")
}

model Lead {
  id                   String      @id @default(cuid())
  public_reference     String      @unique
  customer_name        String
  customer_domain      String?
  contact_first_name   String
  contact_last_name    String
  contact_email        String
  contact_phone        String?
  company              String
  country              String
  region               String?
  industry             String?
  lead_source          String
  product_interest     String?
  estimated_seat_count Int?
  customer_comment     String?
  internal_notes       String?
  status               LeadStatus  @default(new)
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt

  assignments          LeadAssignment[]

  @@index([status])
  @@index([customer_domain])
  @@index([country])
  @@index([created_at])
  @@map("leads")
}

model LeadAssignment {
  id                            String               @id @default(cuid())
  lead_id                       String
  partner_organization_id       String
  assigned_by_user_id           String
  assigned_at                   DateTime             @default(now())
  acceptance_deadline_at        DateTime
  partner_acceptance_status     LeadAcceptanceStatus @default(pending)
  accepted_at                   DateTime?
  declined_at                   DateTime?
  decline_reason                String?
  current_status                String               @default("assigned")
  created_at                    DateTime             @default(now())
  updated_at                    DateTime             @updatedAt

  lead                          Lead                 @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  organization                  PartnerOrganization  @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)
  assigned_by                   User                 @relation("LeadsAssignedBy", fields: [assigned_by_user_id], references: [id])
  converted_deal                DealRegistration?    @relation("ConvertedDeal")

  @@index([partner_organization_id])
  @@index([lead_id])
  @@index([partner_acceptance_status])
  @@index([acceptance_deadline_at])
  @@map("lead_assignments")
}

model Renewal {
  id                      String              @id @default(cuid())
  partner_organization_id String
  customer_name           String
  product_plan            String
  contracted_capacity     String?
  renewal_date            DateTime
  contract_value          Float?
  currency                String              @default("USD")
  commercial_status       String              @default("upcoming")
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  organization            PartnerOrganization @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)

  @@index([partner_organization_id])
  @@index([renewal_date])
  @@map("renewals")
}

model ResourceItem {
  id               String           @id @default(cuid())
  title            String
  description      String
  category         ResourceCategory
  url              String
  visible_to_tiers String[]         @default(["Registered", "Silver", "Gold", "Platinum"])
  is_published     Boolean          @default(true)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  @@index([category])
  @@index([is_published])
  @@map("resource_items")
}

model AuditEvent {
  id                      String               @id @default(cuid())
  actor_user_id           String?
  partner_organization_id String?
  entity_type             String
  entity_id               String
  event_type              String
  before_data             Json?
  after_data              Json?
  metadata                Json?
  ip_address              String?
  created_at              DateTime             @default(now())

  actor                   User?                @relation(fields: [actor_user_id], references: [id])
  organization            PartnerOrganization? @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)

  @@index([partner_organization_id])
  @@index([actor_user_id])
  @@index([entity_type, entity_id])
  @@index([event_type])
  @@index([created_at])
  @@map("audit_events")
}

model Notification {
  id                      String               @id @default(cuid())
  user_id                 String?
  partner_organization_id String?
  title                   String
  message                 String
  link                    String?
  is_read                 Boolean              @default(false)
  type                    String               @default("info")
  created_at              DateTime             @default(now())

  user                    User?                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization            PartnerOrganization? @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([partner_organization_id])
  @@index([is_read])
  @@index([created_at])
  @@map("notifications")
}

model CommercialRequest {
  id                      String              @id @default(cuid())
  public_reference        String              @unique
  partner_organization_id String
  requested_by_user_id    String
  request_type            String              // poc, customer_trial, nfr_license, quote_request, order_assistance, license_expansion
  status                  String              @default("submitted") // draft, submitted, in_review, approved, rejected, fulfilled
  title                   String
  customer_name           String?
  seats_nodes             Int?
  details                 String
  admin_notes             String?
  fulfilled_at            DateTime?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  organization            PartnerOrganization @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)
  requested_by            User                @relation("CommercialRequestsByUser", fields: [requested_by_user_id], references: [id])

  @@index([partner_organization_id])
  @@index([status])
  @@index([created_at])
  @@map("commercial_requests")
}

model Course {
  id               String             @id @default(cuid())
  title            String
  description      String
  track            String             // Sales, Presales, Technical
  level            String             // Fundamental, Intermediate, Advanced
  duration_minutes Int                @default(60)
  modules_count    Int                @default(4)
  is_published     Boolean            @default(true)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  enrollments      CourseEnrollment[]

  @@index([track])
  @@index([level])
  @@map("courses")
}

model CourseEnrollment {
  id                      String              @id @default(cuid())
  course_id               String
  user_id                 String
  partner_organization_id String
  status                  String              @default("in_progress") // enrolled, in_progress, completed
  progress_percent        Int                 @default(0)
  completed_at            DateTime?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  course                  Course              @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user                    User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization            PartnerOrganization @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)

  @@unique([course_id, user_id])
  @@index([partner_organization_id])
  @@index([user_id])
  @@map("course_enrollments")
}

model Certification {
  id                      String                 @id @default(cuid())
  code                    String                 @unique // e.g. OCSP, OCIE, OCSE
  name                    String
  description             String
  track                   String                 // Sell, Deploy, Manage
  level                   String
  validity_months         Int                    @default(24)
  created_at              DateTime               @default(now())

  partner_certifications  PartnerCertification[]

  @@map("certifications")
}

model PartnerCertification {
  id                      String              @id @default(cuid())
  certification_id        String
  user_id                 String
  partner_organization_id String
  certificate_number      String              @unique
  issued_at               DateTime            @default(now())
  expires_at              DateTime
  status                  String              @default("active") // active, expiring_soon, expired
  verified_by_admin       Boolean             @default(true)
  created_at              DateTime            @default(now())

  certification           Certification       @relation(fields: [certification_id], references: [id], onDelete: Cascade)
  user                    User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization            PartnerOrganization @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)

  @@index([partner_organization_id])
  @@index([user_id])
  @@index([status])
  @@map("partner_certifications")
}

model Campaign {
  id               String    @id @default(cuid())
  title            String
  summary          String
  related_product  String
  target_audience  String
  start_date       DateTime
  end_date         DateTime?
  status           String    @default("active") // active, upcoming, ended
  assets_url       String?
  email_copy       String?
  social_copy      String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([status])
  @@map("campaigns")
}

model Event {
  id               String              @id @default(cuid())
  title            String
  event_type       String              // webinar, technical_workshop, partner_briefing, summit
  description      String
  starts_at        DateTime
  duration_minutes Int                 @default(60)
  timezone         String              @default("UTC")
  product_area     String
  recording_url    String?
  meeting_link     String?
  is_published     Boolean             @default(true)
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  registrations    EventRegistration[]

  @@index([starts_at])
  @@index([is_published])
  @@map("events")
}

model EventRegistration {
  id                      String              @id @default(cuid())
  event_id                String
  user_id                 String
  partner_organization_id String
  registered_at           DateTime            @default(now())
  attended                Boolean             @default(false)

  event                   Event               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user                    User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization            PartnerOrganization @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([partner_organization_id])
  @@index([user_id])
  @@map("event_registrations")
}

model JointBusinessPlan {
  id                      String              @id @default(cuid())
  partner_organization_id String
  year                    Int
  growth_goals            String
  revenue_target          Float
  focus_products          String
  target_industries       String
  key_accounts            String?
  technical_plan          String?
  marketing_activities    String?
  milestones              String?
  status                  String              @default("draft") // draft, submitted, under_review, changes_requested, approved, archived
  admin_feedback          String?
  submitted_at            DateTime?
  approved_at             DateTime?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  organization            PartnerOrganization @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)

  @@index([partner_organization_id])
  @@index([year])
  @@index([status])
  @@map("joint_business_plans")
}

model TermsAcceptance {
  id                      String              @id @default(cuid())
  user_id                 String
  partner_organization_id String
  terms_version           String
  policy_name             String
  accepted_at             DateTime            @default(now())
  ip_address              String?

  user                    User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization            PartnerOrganization @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)

  @@index([partner_organization_id])
  @@index([user_id])
  @@map("terms_acceptances")
}

model PartnerLocatorProfile {
  id                      String              @id @default(cuid())
  partner_organization_id String              @unique
  opt_in                  Boolean             @default(false)
  is_approved             Boolean             @default(false)
  is_published            Boolean             @default(false)
  public_company_name     String
  public_description      String?
  website                 String?
  country                 String
  region                  String?
  city                    String?
  partner_type            String
  tracks                  String[]            @default([])
  industry_focus          String[]            @default([])
  tier                    PartnerTier         @default(Registered)
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  organization            PartnerOrganization @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)

  @@index([is_published])
  @@index([country])
  @@map("partner_locator_profiles")
}

model Announcement {
  id               String    @id @default(cuid())
  title            String
  content          String
  priority         String    @default("normal") // normal, important, critical
  is_published     Boolean   @default(true)
  published_at     DateTime  @default(now())
  created_at       DateTime  @default(now())

  @@index([is_published])
  @@index([published_at])
  @@map("announcements")
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum TicketStatus {
  open
  in_progress
  awaiting_partner
  resolved
  closed
}

model SupportTicket {
  id                      String              @id @default(cuid())
  ticket_number           String              @unique
  subject                 String
  category                String              // ai_pam_engine, mcp_governance, vault_encryption, remote_access_proxy, licensing_billing, general
  priority                TicketPriority      @default(medium)
  status                  TicketStatus        @default(open)
  partner_organization_id String?
  created_by_user_id      String
  assigned_to_user_id     String?
  resolved_at             DateTime?
  closed_at               DateTime?
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt

  created_by              User                @relation("TicketsCreated", fields: [created_by_user_id], references: [id], onDelete: Cascade)
  assigned_to             User?               @relation("TicketsAssigned", fields: [assigned_to_user_id], references: [id], onDelete: SetNull)
  organization            PartnerOrganization? @relation(fields: [partner_organization_id], references: [id], onDelete: Cascade)
  messages                TicketMessage[]

  @@index([status])
  @@index([priority])
  @@index([partner_organization_id])
  @@index([created_by_user_id])
  @@index([assigned_to_user_id])
  @@map("support_tickets")
}

model TicketMessage {
  id               String         @id @default(cuid())
  ticket_id        String
  sender_user_id   String
  message          String
  is_internal_note Boolean        @default(false)
  attachments      String[]       @default([])
  created_at       DateTime       @default(now())

  ticket           SupportTicket  @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  sender           User           @relation(fields: [sender_user_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([sender_user_id])
  @@map("ticket_messages")
}

model SupportFaq {
  id            String    @id @default(cuid())
  question      String
  answer        String
  category      String    // AI-PAM Engine, MCP Tool Controls, Key Hierarchy & Vaulting, Proxy Gateway, Deal & Tier Support, Billing & Licensing
  tags          String[]  @default([])
  order_index   Int       @default(0)
  is_published  Boolean   @default(true)
  view_count    Int       @default(0)
  helpful_count Int       @default(0)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([category])
  @@index([is_published])
  @@map("support_faqs")
}

enum ProductLicenseStatus {
  active
  expired
  revoked
}

model ProductLicense {
  id               String               @id @default(cuid())
  org_id           String
  customer_name    String?
  license_key      String               @unique
  status           ProductLicenseStatus @default(active)
  duration_value   Int
  duration_unit    String               // days, months, years
  starts_at        DateTime             @default(now())
  expires_at       DateTime
  max_assets       Int?
  max_users        Int?
  modules          String               @default("ssh,rdp,db,web")
  revoked_at       DateTime?
  revoked_by_id    String?
  issued_by_id     String?
  last_verified_at DateTime?
  // Reseller partner that sold this license (optional); scopes partner-portal visibility.
  partner_organization_id String?
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt

  partner_organization PartnerOrganization? @relation(fields: [partner_organization_id], references: [id], onDelete: SetNull)

  @@index([org_id])
  @@index([partner_organization_id])
  @@index([status])
  @@index([expires_at])
  @@map("product_licenses")
}


