# PostgreSQL Database Connection (Transaction Pooler for Prisma)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Database Connection (Session Pooler or Direct for Migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Session Secret (min 32 characters for AES-256 session token encryption)
SESSION_SECRET="generate-a-strong-32-byte-secret-for-omnipriv-portal"

# Node Environment
NODE_ENV="development"

# Seed Initial Channel Admin (Idempotent seed from environment only)
CHANNEL_ADMIN_EMAIL="admin@omnipriv.internal"
CHANNEL_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword123!"
CHANNEL_ADMIN_NAME="OmniPriv Channel Operations"

# Shared Bearer token for OmniPrive -> PP license verification (POST /api/licenses/verify)
PP_API_KEY="replace_with_shared_secret_key"

# Shared with the customer support portal for one-time Partner Portal -> support sign-in (min 32 bytes; same value on both apps)
SUPPORT_SSO_SECRET="generate-a-different-strong-32-byte-secret"
# Customer support portal origin (Support link target)
SUPPORT_PORTAL_URL="https://support.omnipriv.com"

# Public origin of this portal, used for links in emails (invites, password resets)
APP_BASE_URL="https://partner.omnipriv.com"

# Transactional email (team invites, password resets). Same variables as the
# customer support app. Email is skipped until SMTP_HOST, SMTP_USER and SMTP_PASSWORD are set.
# omnipriv.com mail is on MXroute: port 465 = implicit TLS (or 587 = STARTTLS).
# Check with: npm run email:verify -- you@example.com
SMTP_HOST="monday.mxrouting.net"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="partner@omnipriv.com"
SMTP_PASSWORD="mailbox-password"
SMTP_FROM="OmniPriv Partner Portal <partner@omnipriv.com>"
# Optional: where replies go (defaults to the From address)
# SMTP_REPLY_TO="partners@omnipriv.com"
